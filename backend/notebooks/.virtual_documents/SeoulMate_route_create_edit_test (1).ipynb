# 여기 정의한 함수로 같은 데이터를 표/타임라인/비교표로도 함께 보여준다.
import html as _html

import pandas as pd
from IPython.display import HTML, display, Markdown


def _fmt_dt(date_value, time_value):
    parts = [str(p) for p in (date_value, time_value) if p not in (None, "")]
    return " ".join(parts) if parts else "-"


def _place_line(place: dict) -> str:
    name = place.get("name", "?")
    category = place.get("category") or place.get("source_type", "")
    bits = [f"**{name}**"]
    if category:
        bits.append(f"_{category}_")
    return " · ".join(bits)


def show_route_timeline(meta: dict, title: str | None = None):
    """루트 응답(meta)을 날짜→슬롯 타임라인 표로 보여준다."""
    heading = title or meta.get("title") or "루트"
    lines = [f"### 🗺️ {heading}"]
    info = []
    for key in ("intent", "route_id", "route_version"):
        if meta.get(key) is not None:
            info.append(f"`{key}={meta[key]}`")
    if meta.get("changed_slot_id"):
        info.append(f"changed=`{meta['changed_slot_id']}`")
    if info:
        lines.append(" ".join(info))
    display(Markdown("\n\n".join(lines)))

    rows = []
    for day in meta.get("days", []):
        for order, slot in enumerate(day.get("slots", []), start=1):
            place = slot.get("place", {})
            alts = slot.get("alternatives", []) or []
            rows.append({
                "Day": day.get("day"),
                "순서": order,
                "슬롯": slot.get("slot_id"),
                "시작": _fmt_dt(slot.get("date"), slot.get("time")),
                "종료": _fmt_dt(slot.get("end_date"), slot.get("end_time")),
                "유형": place.get("source_type", ""),
                "장소": place.get("name", ""),
                "카테고리": place.get("category", "") or "",
                "대안 수": len(alts),
                "대안": ", ".join(a.get("place", {}).get("name") or a.get("name", "?") for a in alts) or "-",
            })
    if rows:
        df = pd.DataFrame(rows)
        display(HTML(df.to_html(index=False, escape=True)))
    else:
        display(Markdown("_슬롯이 없습니다._"))


def show_saved_route(route: dict, title: str | None = None):
    """저장 스냅샷(SAVED_ROUTE)을 요약 + 슬롯 표로 보여준다."""
    period = route.get("period", {}) or {}
    header = title or route.get("title") or "저장 루트"
    meta_bits = [
        f"**{header}**",
        f"route_id `{route.get('route_id')}` · v{route.get('version')}",
        f"목적지 {route.get('destination') or '-'}",
        f"기간 {period.get('days', '?')}일 {period.get('nights', '?')}박",
        f"슬롯 {len(route.get('slots', []))}개",
    ]
    display(Markdown("### 💾 " + "  ·  ".join(meta_bits)))

    rows = []
    for slot in route.get("slots", []):
        place = slot.get("place", {})
        rows.append({
            "Day": slot.get("day_number"),
            "슬롯": slot.get("slot_id"),
            "시작": _fmt_dt(slot.get("date"), slot.get("start_time")),
            "종료": _fmt_dt(slot.get("end_date"), slot.get("end_time")),
            "유형": place.get("source_type", ""),
            "장소": place.get("name", ""),
            "대안": ", ".join(a["place"]["name"] for a in slot.get("alternatives", [])) or "-",
        })
    if rows:
        display(HTML(pd.DataFrame(rows).to_html(index=False, escape=True)))


def show_structured_query(query, title: str = "구조화 질의"):
    """StructuredTravelQuery 를 상단 요약 + Task 표로 보여준다."""
    data = query.model_dump(mode="json") if hasattr(query, "model_dump") else query
    top = [f"**intent** `{data.get('intent')}`"]
    route_req = data.get("route_request")
    if route_req:
        period = route_req.get("period", {}) or {}
        top.append(f"**목적지** {route_req.get('destination') or '-'}")
        top.append(f"**기간** {period.get('days', '?')}일 {period.get('nights', '?')}박")
    filters = data.get("filters") or {}
    active_filters = {k: v for k, v in filters.items() if v not in (None, "", [], {})}
    display(Markdown("### 🧭 " + title + "\n\n" + "  ·  ".join(top)))
    if active_filters:
        display(Markdown("**전역 필터**: " + ", ".join(f"`{k}={v}`" for k, v in active_filters.items())))

    rows = []
    for task in data.get("tasks", []):
        task_filters = {k: v for k, v in (task.get("filters") or {}).items() if v not in (None, "", [], {})}
        rows.append({
            "task_id": task.get("task_id"),
            "slot_id": task.get("slot_id") or "-",
            "도메인": task.get("domain"),
            "Day": task.get("day_number") if task.get("day_number") is not None else "-",
            "방문일": task.get("visit_date") or "-",
            "시작": task.get("start_time") or "-",
            "검색어": task.get("search_query", ""),
            "테마": ", ".join(task.get("themes") or []) or "-",
            "필터": ", ".join(f"{k}={v}" for k, v in task_filters.items()) or "-",
        })
    if rows:
        display(HTML(pd.DataFrame(rows).to_html(index=False, escape=True)))


def show_change_comparison(before_meta: dict, after_meta: dict, target_slot_id: str):
    """수정 전/후 루트를 슬롯별로 나란히 비교한다. 바뀐 슬롯은 강조한다."""
    before = {slot["slot_id"]: slot for day in before_meta.get("days", []) for slot in day.get("slots", [])}
    after = {slot["slot_id"]: slot for day in after_meta.get("days", []) for slot in day.get("slots", [])}

    rows = []
    for slot_id in before:
        b_place = before[slot_id].get("place", {})
        a_place = after.get(slot_id, {}).get("place", {})
        changed = b_place.get("source_id") != a_place.get("source_id")
        rows.append({
            "슬롯": slot_id,
            "변경 전": b_place.get("name", ""),
            "변경 후": a_place.get("name", ""),
            "대상": "🎯" if slot_id == target_slot_id else "",
            "변경됨": "✅ 교체" if changed else "· 유지",
            "대안 수": len(after.get(slot_id, {}).get("alternatives", []) or []),
        })
    df = pd.DataFrame(rows)

    def _highlight(row):
        if row["대상"] == "🎯":
            return ["background-color: #FFF3CD"] * len(row)
        if row["변경됨"].startswith("✅"):
            return ["background-color: #E7F5E9"] * len(row)
        return [""] * len(row)

    display(Markdown(f"### 🔁 루트 수정 비교 (대상 슬롯 `{target_slot_id}`)"))
    try:
        display(df.style.apply(_highlight, axis=1).hide(axis="index"))
    except Exception:
        display(HTML(df.to_html(index=False, escape=True)))


print("보기 쉬운 출력 헬퍼 준비 완료: "
