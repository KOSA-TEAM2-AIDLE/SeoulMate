ROUTE_PARSER_RULES = r"""

[Route 추가 규칙]
- day_trip_route와 multi_day_route에서는 하나의 Task가 하나의 방문 슬롯이다.
- 각 Task에 고유한 slot_id, day_number, visit_date, start_time을 반드시 채운다.
- slot_id는 d{{day_number}}-{{domain}}-{{순번}}처럼 안정적으로 만든다.
- 숙박 Task는 체크인 start_time과 다음 날 end_date/end_time을 채운다.
- route_request를 반드시 만들고 destination, period, max_places_per_day를 채운다.
- period의 days는 날짜 범위와 일치하고 nights=days-1이어야 한다.
- 당일 루트는 nights=0, days=1이다.
- 1박 2일은 nights=1, days=2이다.
- modify_route에서는 교체할 장소의 domain Task 하나만 만들고 slot_id를 명시한다.
- 날씨는 domain Task로 만들지 말고 weather_request에만 기록한다.
"""

parser_chain = (
    ChatPromptTemplate.from_messages([
        ("system", PARSER_SYSTEM_PROMPT + ROUTE_PARSER_RULES),
        ("human", PARSER_HUMAN_PROMPT),
    ])
    | ChatOpenAI(model="gpt-4o-mini", temperature=0).with_structured_output(
        StructuredTravelQuery,
        method="function_calling",
    )
)

USER_CONTEXT = {
    "current_location": {"latitude": 37.5563, "longitude": 126.9236},
    "location_name": "홍대",
    "timezone": "Asia/Seoul",
}

async def parse_live(question: str) -> StructuredTravelQuery:
    parsed = await parser_chain.ainvoke({
        "today": date.today().isoformat(),
        "user_context": json.dumps(USER_CONTEXT, ensure_ascii=False),
        "question": question,
    })
    # function calling 결과를 운영 Pydantic 스키마로 다시 검증한다.
    return StructuredTravelQuery.model_validate(parsed.model_dump(mode="json"))

print("실제 gpt-4o-mini Parser 준비 완료")





REQUIRE_LIVE_WEATHER_MCP = True

def candidate_rows(candidates, limit=10):
    return [
        {
            "rank": rank,
            "restaurant_id": str(candidate["restaurant_id"]),
            "name": candidate["name"],
            "score": round(float(candidate["score"]), 6),
            "rag_score": round(float(candidate.get("rag_score", candidate["score"])), 6),
            "weather_score": candidate.get("weather_score"),
            "distance_km": None if candidate.get("distance_km") is None else round(candidate["distance_km"], 2),
            "rating": candidate.get("rating"),
            "open_status": candidate.get("open_status"),
            "weather_reasons": candidate.get("weather_reasons", []),
            "menus": [menu.get("menu_name") for menu in candidate.get("evidence", {}).get("menus", [])],
        }
        for rank, candidate in enumerate(candidates[:limit], start=1)
    ]

async def debug_live_restaurant_tasks(parsed: StructuredTravelQuery):
    traces = {}
    for task in parsed.tasks:
        if task.domain != "restaurant":
            continue
        plan = build_restaurant_search_plan(
            parsed,
            task,
            current_lat=USER_CONTEXT["current_location"]["latitude"],
            current_lng=USER_CONTEXT["current_location"]["longitude"],
            current_location_name=USER_CONTEXT["location_name"],
            top_n=30,
        )
        result = await asyncio.to_thread(
            search_restaurants_structured,
            parsed,
            task,
            current_lat=USER_CONTEXT["current_location"]["latitude"],
            current_lng=USER_CONTEXT["current_location"]["longitude"],
            current_location_name=USER_CONTEXT["location_name"],
            top_n=30,
        )
        raw_candidates = result["candidates"]
        weather = None
        ranked = prepare_rag_only_candidates(copy.deepcopy(raw_candidates))
        if derive_source_mode(parsed) == "rag_mcp":
            weather = await get_weather_via_mcp(
                parsed.original_question,
                plan.origin_lat,
                plan.origin_lng,
                parsed.language,
                plan.location_name,
                target_date=str(task.visit_date or trusted_visit_date(parsed) or "") or None,
                target_time=task.start_time or trusted_time_window(parsed),
            )
            if REQUIRE_LIVE_WEATHER_MCP and not weather.get("available"):
                raise RuntimeError(f"Weather MCP 실제 호출 실패: {weather.get('error')}")
            ranked = rerank_with_weather(
                copy.deepcopy(raw_candidates), weather,
                parsed.original_question, source_mode="rag_mcp"
            )
        trace = {
            "plan": {
                "task_id": plan.task_id,
                "retrieval_query": plan.retrieval_query,
                "review_query": plan.review_query,
                "menu_query": plan.menu_query,
                "required_menu_terms": list(plan.required_menu_terms),
                "location_name": plan.location_name,
                "radius_km": plan.radius_km,
                "target_visit_at": None if plan.target_visit_at is None else plan.target_visit_at.isoformat(),
                "required_features": list(plan.required_feature_fields),
            },
            "raw_rag_ranking": candidate_rows(raw_candidates),
            "weather": weather,
            "final_ranking": candidate_rows(ranked),
        }
        traces[task.task_id] = trace
        display(JSON({task.task_id: trace}, expanded=True))
        assert raw_candidates, f"{task.task_id}: 실제 RAG 후보가 없습니다."
    return traces

print("실제 RAG·MCP 디버그 도우미 준비 완료")





PLANNER_INPUT_HISTORY = []

def deterministic_route_plan(planner_input):
    PLANNER_INPUT_HISTORY.append(planner_input)
    raw = {
        "title": "실제 검색 후보 검증 루트",
        "summary": "실제 RAG·MCP 후보의 서버 순위를 사용한 종단 테스트 루트입니다.",
        "selections": [
            {
                "slot_id": slot.slot_id,
                "selected_candidate_id": slot.candidates[0].candidate_id,
                "selection_reason": "실제 검색과 재랭킹 결과의 최상위 후보입니다.",
                "alternatives": [
                    {
                        "candidate_id": candidate.candidate_id,
                        "selection_reason": f"실제 검색 순위 {rank + 1}위 대안입니다.",
                    }
                    for rank, candidate in enumerate(slot.candidates[1:3], start=1)
                ],
            }
            for slot in planner_input.slots
        ],
    }
    return validate_route_planner_output(json.dumps(raw, ensure_ascii=False), planner_input)

def decode_sse(event):
    return json.loads(event.removeprefix("data: "))

async def run_backend_route(body: ChatRequest):
    # 검색과 MCP는 실제 코드. Route Planner GPT만 고정 선택으로 교체한다.
    with patch("routers.chat.generate_route_plan", side_effect=deterministic_route_plan):
        return [decode_sse(event) async for event in _stream(body)]

def meta_event(events):
    errors = [event for event in events if event.get("type") == "error"]
    if errors:
        raise RuntimeError(errors)
    return next(event for event in events if event.get("type") == "meta")

