def saved_place(place):
    return {
        "source_type": place["source_type"],
        "source_id": place["source_id"],
        "restaurant_id": place.get("restaurant_id"),
        "name": place["name"],
        "category": place.get("category", ""),
        "lat": place.get("lat"),
        "lng": place.get("lng"),
        "selection_reason": place.get("selection_reason"),
    }

saved_slots = []
for day in day_meta["days"]:
    for slot in day["slots"]:
        saved_slots.append({
            "slot_id": slot["slot_id"],
            "day_number": day["day"],
            "date": slot["date"],
            "start_time": slot["time"],
            "end_date": slot.get("end_date"),
            "end_time": slot.get("end_time"),
            "place": saved_place(slot["place"]),
            "alternatives": [
                {"place": saved_place(place), "selection_reason": place.get("selection_reason") or "대안"}
                for place in slot["alternatives"]
            ],
        })

