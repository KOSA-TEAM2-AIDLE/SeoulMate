        cwd=BACKEND_DIR,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
    )
    weather_mcp_started_here = True
    for _ in range(40):
        time.sleep(0.5)
        healthy, health_payload = weather_health()
        if healthy:
            break

